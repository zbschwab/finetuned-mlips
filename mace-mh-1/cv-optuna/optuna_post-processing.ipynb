        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "results = pd.read_csv(\"cv-results/zeroshot.csv\")\n",
        "\n",
        "fig, axs = plt.subplots(2, 2, figsize=(10, 8), sharex=False, sharey=False)\n",
        "axs = axs.ravel()\n",
        "\n",
        "for fold in range(4):\n",
        "    ax = axs[fold]\n",
        "    fold_df = results[results[\"fold\"] == fold]\n",
        "\n",
        "    # Energy residual\n",
        "    energy_error = fold_df[\"mlip_energy\"] - fold_df[\"dft_energy\"]\n",
        "\n",
        "    # Force residual\n",
        "    force_error = fold_df[\"mlip_force\"] - fold_df[\"dft_force\"]\n",
        "\n",
        "    ax.scatter(\n",
        "        fold_df[\"dft_energy\"],\n",
        "        energy_error,\n",
        "        s=15,\n",
        "        label=\"Energy error\"\n",
        "    )\n",
        "\n",
        "    ax.scatter(\n",
        "        fold_df[\"dft_energy\"],\n",
        "        force_error,\n",
        "        s=15,\n",
        "        label=\"Force error\"\n",
        "    )\n",
        "\n",
        "    ax.axhline(0, linestyle=\"--\")\n",
        "\n",
        "    energy_rmse = np.sqrt(np.mean(energy_error**2))\n",
        "    force_rmse = np.sqrt(np.mean(force_error**2))\n",
        "\n",
        "    ax.set_title(\n",
        "        f\"Fold {fold}\\n\"\n",
        "        f\"E RMSE={energy_rmse:.4f}, F RMSE={force_rmse:.4f}\"\n",
        "    )\n",
        "\n",
        "    ax.set_xlabel(\"DFT Energy\")\n",
        "    ax.set_ylabel(\"MLIP - DFT\")\n",
        "\n",
        "    ax.legend()\n",
        "\n",
        "fig.suptitle(\"Zero-Shot Residuals: MACE - DFT\")\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ]
    },
