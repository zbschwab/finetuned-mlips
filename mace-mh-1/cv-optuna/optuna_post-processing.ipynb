        "\n",
        "    kept = [a for i, a in enumerate(configs) if a.get_chemical_formula() != FORMULA_TO_REMOVE]\n",
        "    write(output_xyz, kept)\n",
        "    print(f\"  wrote {len(kept)}/{len(configs)} configs -> {output_xyz}\")"
