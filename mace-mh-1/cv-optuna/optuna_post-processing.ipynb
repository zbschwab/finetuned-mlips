        "ax.plot(df.sort_values(\"number\")[\"number\"], running_best, \"--\", label=\"Running Best\")\n",
        "ax.set_xlabel(\"trial\")\n",
        "ax.set_ylabel(\"Objective\")\n",
        "ax.set_title(\"Optimization History: Objective vs. Trial\")\n",
